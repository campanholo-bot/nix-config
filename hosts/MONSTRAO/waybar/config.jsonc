{
  "position": "bottom",
  "start_hidden": true,
  "modules-left": ["niri/workspaces"],
  "modules-center": ["niri/window"],
  "modules-right": ["pulseaudio", "clock"],
  "pulseaudio": {
    "format": "{volume}%",
    "format-muted": "muted",
    "on-click": "/run/current-system/sw/bin/pavucontrol"
  },
  "clock": {
    "format": "{:%a %b %d %H:%M}"
  }
}
